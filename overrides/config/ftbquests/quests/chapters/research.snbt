			y: 1.5d
		}
		{
			dependencies: ["451B008040DBAE48"]
			description: [
				"If there is valid science in the laboratory (correct tier), the bar will progress."
				"When the bar is done progressing, it will add X to the counter, where X is the number of unique valid science packs in the laboratory."
				"When the counter is done, the science is unlocked!"
				""
				"Depending on the tech, this might unlock object interaction, posession, placement, interaction with any machine of a given voltage tier, or a combination of the above."
			]
			icon: "tfg:beaker"
